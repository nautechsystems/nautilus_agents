{
  "$defs": {
    "ContentDigest": {
      "description": "Stores a lowercase SHA-256 content digest.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "IdempotencyKey": {
      "description": "Carries a caller-supplied key that NautilusTrader scopes to the authenticated principal.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[\\u0000-\\u007f]+$",
      "type": "string"
    },
    "InstrumentId": {
      "description": "Identifies an instrument without exposing engine types.",
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
      "type": "string"
    },
    "LiveIntent": {
      "description": "Enumerates the live proposal vocabulary for protocol 1.0.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Proposes reducing an existing position without adding risk.",
          "properties": {
            "reduce_position": {
              "$ref": "#/$defs/ReducePosition"
            }
          },
          "required": [
            "reduce_position"
          ],
          "type": "object"
        }
      ]
    },
    "LiveProposal": {
      "additionalProperties": false,
      "description": "Wraps the single live intent carried by a request.",
      "properties": {
        "intent": {
          "$ref": "#/$defs/LiveIntent",
          "description": "The semantic intent for NautilusTrader to consider."
        }
      },
      "required": [
        "intent"
      ],
      "type": "object"
    },
    "ObservationId": {
      "description": "Identifies an observation constructed by NautilusTrader.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "ObservationRef": {
      "additionalProperties": false,
      "description": "Links a request or trace to exact observation content.",
      "properties": {
        "digest": {
          "$ref": "#/$defs/ContentDigest",
          "description": "The exact observation content digest."
        },
        "id": {
          "$ref": "#/$defs/ObservationId",
          "description": "The observation identity."
        }
      },
      "required": [
        "id",
        "digest"
      ],
      "type": "object"
    },
    "PositionId": {
      "description": "Identifies a position without exposing engine types.",
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
      "type": "string"
    },
    "ProtocolVersion": {
      "additionalProperties": false,
      "description": "Identifies an external protocol revision independently of crate SemVer.",
      "properties": {
        "major": {
          "description": "The compatibility-breaking protocol component.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "minor": {
          "description": "The backward-compatible protocol component.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "major",
        "minor"
      ],
      "type": "object"
    },
    "Quantity": {
      "description": "Stores a strictly positive canonical decimal quantity.",
      "pattern": "^(?:[1-9][0-9]*|(?:0|[1-9][0-9]*)\\.[0-9]{0,15}[1-9])$",
      "type": "string"
    },
    "ReducePosition": {
      "additionalProperties": false,
      "description": "Identifies an existing position and the quantity to reduce.",
      "properties": {
        "instrument_id": {
          "$ref": "#/$defs/InstrumentId",
          "description": "The instrument expected for the fresh position."
        },
        "position_id": {
          "$ref": "#/$defs/PositionId",
          "description": "The position to reduce."
        },
        "quantity": {
          "$ref": "#/$defs/Quantity",
          "description": "The strictly positive reduction quantity."
        }
      },
      "required": [
        "position_id",
        "instrument_id",
        "quantity"
      ],
      "type": "object"
    },
    "RequestId": {
      "description": "Identifies a caller-created proposal request.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "TraceId": {
      "description": "Identifies an agent-side trace.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$id": "https://schemas.nautilustrader.io/agents/v1/live-proposal-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Submits one semantic live proposal against an exact observation.",
  "properties": {
    "agent_trace_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/TraceId"
        },
        {
          "type": "null"
        }
      ],
      "description": "An optional link to the agent-side trace."
    },
    "idempotency_key": {
      "$ref": "#/$defs/IdempotencyKey",
      "description": "The caller-created key that NautilusTrader scopes to the principal."
    },
    "observation": {
      "$ref": "#/$defs/ObservationRef",
      "description": "The exact observation used by the policy."
    },
    "proposal": {
      "$ref": "#/$defs/LiveProposal",
      "description": "The single semantic proposal."
    },
    "request_id": {
      "$ref": "#/$defs/RequestId",
      "description": "The caller-created request identity."
    },
    "version": {
      "$ref": "#/$defs/ProtocolVersion",
      "description": "The external protocol version."
    }
  },
  "required": [
    "version",
    "request_id",
    "idempotency_key",
    "observation",
    "proposal"
  ],
  "title": "LiveProposalRequest",
  "type": "object"
}
