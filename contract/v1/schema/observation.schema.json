{
  "$defs": {
    "CapabilityGrant": {
      "additionalProperties": false,
      "description": "Describes the effective scope disclosed with one observation.",
      "properties": {
        "expires_at": {
          "$ref": "#/$defs/TimestampNs",
          "description": "The time at which the disclosed grant expires."
        },
        "instruments": {
          "description": "The instruments covered by the grant.",
          "items": {
            "$ref": "#/$defs/InstrumentId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "observations": {
          "description": "The observation categories disclosed in the payload.",
          "items": {
            "$ref": "#/$defs/ObservationCapability"
          },
          "type": "array",
          "uniqueItems": true
        },
        "proposals": {
          "description": "The proposal categories NautilusTrader may consider.",
          "items": {
            "$ref": "#/$defs/ProposalCapability"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "observations",
        "proposals",
        "instruments",
        "expires_at"
      ],
      "type": "object"
    },
    "ContentDigest": {
      "description": "Stores a lowercase SHA-256 content digest.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "FieldOmission": {
      "additionalProperties": false,
      "description": "Records why NautilusTrader did not disclose a field or subtree.",
      "properties": {
        "field": {
          "$ref": "#/$defs/FieldPath",
          "description": "The omitted field or subtree."
        },
        "reason": {
          "$ref": "#/$defs/OmissionReason",
          "description": "The omission reason."
        }
      },
      "required": [
        "field",
        "reason"
      ],
      "type": "object"
    },
    "FieldPath": {
      "description": "Stores an RFC 6901 JSON Pointer.",
      "pattern": "^(?:|(?:/(?:[^~/]|~[01])*)+)$",
      "type": "string"
    },
    "InstrumentId": {
      "description": "Identifies an instrument without exposing engine types.",
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
      "type": "string"
    },
    "InstrumentView": {
      "additionalProperties": false,
      "description": "Contains the minimum instrument rules needed by a proposal policy.",
      "properties": {
        "instrument_id": {
          "$ref": "#/$defs/InstrumentId",
          "description": "The instrument identity."
        },
        "quantity_increment": {
          "$ref": "#/$defs/Quantity",
          "description": "The permitted quantity increment."
        }
      },
      "required": [
        "instrument_id",
        "quantity_increment"
      ],
      "type": "object"
    },
    "LiveObservation": {
      "additionalProperties": false,
      "description": "Contains the live views disclosed for one observation.",
      "properties": {
        "instruments": {
          "description": "The scoped instrument summaries.",
          "items": {
            "$ref": "#/$defs/InstrumentView"
          },
          "type": "array"
        },
        "positions": {
          "description": "The scoped position summaries.",
          "items": {
            "$ref": "#/$defs/PositionView"
          },
          "type": "array"
        }
      },
      "required": [
        "positions",
        "instruments"
      ],
      "type": "object"
    },
    "ObservationCapability": {
      "description": "Names an observation category that NautilusTrader may disclose.",
      "oneOf": [
        {
          "const": "position_summary",
          "description": "Includes scoped position summaries.",
          "type": "string"
        },
        {
          "const": "instrument_summary",
          "description": "Includes scoped instrument summaries.",
          "type": "string"
        }
      ]
    },
    "ObservationId": {
      "description": "Identifies an observation constructed by NautilusTrader.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "ObservationPayload": {
      "description": "Contains the protocol-specific observation domain.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Contains the live proposal-authoring view.",
          "properties": {
            "live": {
              "$ref": "#/$defs/LiveObservation"
            }
          },
          "required": [
            "live"
          ],
          "type": "object"
        }
      ]
    },
    "OmissionReason": {
      "description": "Explains why an observation field is absent.",
      "oneOf": [
        {
          "const": "not_granted",
          "description": "The effective grant did not include the field.",
          "type": "string"
        },
        {
          "const": "unavailable",
          "description": "NautilusTrader could not obtain the field.",
          "type": "string"
        },
        {
          "const": "redacted",
          "description": "NautilusTrader redacted the field.",
          "type": "string"
        },
        {
          "const": "unsupported",
          "description": "The current protocol cannot represent the field.",
          "type": "string"
        }
      ]
    },
    "PositionId": {
      "description": "Identifies a position without exposing engine types.",
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
      "type": "string"
    },
    "PositionSide": {
      "description": "Identifies the direction of an open position.",
      "oneOf": [
        {
          "const": "long",
          "description": "The position is long.",
          "type": "string"
        },
        {
          "const": "short",
          "description": "The position is short.",
          "type": "string"
        }
      ]
    },
    "PositionView": {
      "additionalProperties": false,
      "description": "Contains the minimum position state needed by a proposal policy.",
      "properties": {
        "instrument_id": {
          "$ref": "#/$defs/InstrumentId",
          "description": "The position's instrument identity."
        },
        "position_id": {
          "$ref": "#/$defs/PositionId",
          "description": "The position identity."
        },
        "quantity": {
          "$ref": "#/$defs/Quantity",
          "description": "The current open quantity."
        },
        "side": {
          "$ref": "#/$defs/PositionSide",
          "description": "The open position side."
        },
        "updated_at": {
          "$ref": "#/$defs/TimestampNs",
          "description": "The last position-state update time."
        }
      },
      "required": [
        "position_id",
        "instrument_id",
        "side",
        "quantity",
        "updated_at"
      ],
      "type": "object"
    },
    "ProposalCapability": {
      "description": "Names a semantic proposal category that NautilusTrader may accept.",
      "oneOf": [
        {
          "const": "reduce_position",
          "description": "Includes position-reduction proposals.",
          "type": "string"
        }
      ]
    },
    "ProtocolVersion": {
      "additionalProperties": false,
      "description": "Identifies an external protocol revision independently of crate SemVer.",
      "properties": {
        "major": {
          "description": "The compatibility-breaking protocol component.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "minor": {
          "description": "The backward-compatible protocol component.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "major",
        "minor"
      ],
      "type": "object"
    },
    "ProvenanceSource": {
      "description": "Names the authoritative source category for a public field.",
      "oneOf": [
        {
          "const": "position_state",
          "description": "NautilusTrader's fresh position state.",
          "type": "string"
        },
        {
          "const": "instrument_definition",
          "description": "NautilusTrader's instrument definition.",
          "type": "string"
        }
      ]
    },
    "Quantity": {
      "description": "Stores a strictly positive canonical decimal quantity.",
      "pattern": "^(?:[1-9][0-9]*|(?:0|[1-9][0-9]*)\\.[0-9]{0,15}[1-9])$",
      "type": "string"
    },
    "RetentionClass": {
      "description": "Classifies observation data for caller-controlled recording.",
      "oneOf": [
        {
          "const": "reference_only",
          "description": "Callers should retain only an observation reference.",
          "type": "string"
        },
        {
          "const": "derived",
          "description": "Callers may retain the derived public payload under their policy.",
          "type": "string"
        },
        {
          "const": "restricted",
          "description": "Callers must not record the full observation through the SDK recorder.",
          "type": "string"
        }
      ]
    },
    "SourceProvenance": {
      "additionalProperties": false,
      "description": "Associates one field path with its source and observation time.",
      "properties": {
        "field": {
          "$ref": "#/$defs/FieldPath",
          "description": "The field or subtree supplied by the source."
        },
        "observed_at": {
          "$ref": "#/$defs/TimestampNs",
          "description": "The time the source value was observed."
        },
        "source": {
          "$ref": "#/$defs/ProvenanceSource",
          "description": "The source category."
        },
        "version": {
          "description": "An optional source version or revision.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "field",
        "source",
        "observed_at"
      ],
      "type": "object"
    },
    "TimestampNs": {
      "description": "Stores unsigned Unix nanoseconds and serializes them as a decimal JSON string.",
      "pattern": "^(?:0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$id": "https://schemas.nautilustrader.io/agents/v1/observation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Contains one complete, versioned observation constructed by NautilusTrader.",
  "properties": {
    "created_at": {
      "$ref": "#/$defs/TimestampNs",
      "description": "The observation construction time."
    },
    "digest": {
      "$ref": "#/$defs/ContentDigest",
      "description": "The canonical SHA-256 digest over every other field."
    },
    "expires_at": {
      "$ref": "#/$defs/TimestampNs",
      "description": "The last time the observation may be used."
    },
    "grant": {
      "$ref": "#/$defs/CapabilityGrant",
      "description": "The effective scope disclosed for this observation."
    },
    "id": {
      "$ref": "#/$defs/ObservationId",
      "description": "The observation identity."
    },
    "omissions": {
      "description": "The fields NautilusTrader withheld or could not provide.",
      "items": {
        "$ref": "#/$defs/FieldOmission"
      },
      "type": "array"
    },
    "payload": {
      "$ref": "#/$defs/ObservationPayload",
      "description": "The protocol payload."
    },
    "provenance": {
      "description": "The source and time for disclosed fields.",
      "items": {
        "$ref": "#/$defs/SourceProvenance"
      },
      "type": "array"
    },
    "retention": {
      "$ref": "#/$defs/RetentionClass",
      "description": "The recording sensitivity assigned by NautilusTrader."
    },
    "version": {
      "$ref": "#/$defs/ProtocolVersion",
      "description": "The external protocol version."
    }
  },
  "required": [
    "version",
    "id",
    "created_at",
    "expires_at",
    "grant",
    "provenance",
    "omissions",
    "retention",
    "payload",
    "digest"
  ],
  "title": "Observation",
  "type": "object"
}
